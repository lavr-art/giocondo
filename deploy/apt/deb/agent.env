# giocondo-vpn-agent settings (the unit EnvironmentFile). On package install it is copied to
# /etc/giocondo-vpn/agent.env if missing; install-agent.sh sets AGENT_PANEL_ADDR.
#
# Panel address host:port; fallbacks are comma-separated. The panel certificate must cover all hosts.
AGENT_PANEL_ADDR=
# AGENT_PANEL_SERVER_NAME=
# AGENT_LOG_LEVEL=info
# AGENT_STATS_INTERVAL=60s
