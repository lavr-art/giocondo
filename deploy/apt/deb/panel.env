# giocondo-vpn-panel settings (the unit EnvironmentFile). Created on package install with random
# secrets; package upgrades do not touch this file. After changes: systemctl restart giocondo-vpn-panel.

# Package paths.
PANEL_DB=/var/lib/giocondo-vpn/panel/panel.db
PANEL_PKI_DIR=/var/lib/giocondo-vpn/panel/pki

# Public address of the panel (behind a reverse proxy with HTTPS) and of subscriptions.
# PANEL_PUBLIC_URL=https://panel.example.com
# PANEL_SUB_URL=https://sub.example.com

# The admin UI and API live under a secret path; "/" serves a stub.
PANEL_ADMIN_PATH=@ADMIN_PATH@
PANEL_ADMIN_PASSWORD=@ADMIN_PASSWORD@
PANEL_SESSION_SECRET=@SESSION_SECRET@

# Where to listen: admin and subscription HTTP for the reverse proxy, gRPC for node agents.
# PANEL_LISTEN=127.0.0.1:8080
# PANEL_SUB_LISTEN=127.0.0.1:8081
# PANEL_GRPC_LISTEN=:9443
# PANEL_AGENT_ADDR=panel.example.com:9443

# Event webhooks (comma-separated) and the secret for the X-Webhook-Secret header.
# PANEL_WEBHOOK_URL=https://hooks.example.com/giocondo-vpn
# PANEL_WEBHOOK_SECRET=
# Delete users whose term expired more than N days ago (0 means never).
# PANEL_AUTODELETE_EXPIRED_DAYS=0

# PANEL_SUB_TITLE=giocondo-vpn
# PANEL_APT_REPO=https://lavr-art.github.io/giocondo
# PANEL_LOG_LEVEL=info

# Managed node DNS (Cloudflare DNS-only A, TTL 60).
# PANEL_DNS_DOMAIN=vpn.example.com
# PANEL_CLOUDFLARE_ZONE_ID=
# PANEL_CLOUDFLARE_API_TOKEN=
# Client port checks; UDP is checked with a real connection through sing-box.
# PANEL_HEALTH_INTERVAL=5m
# PANEL_SINGBOX_BIN=/usr/lib/giocondo-vpn/sing-box
# PANEL_PROBE_CHALLENGE_URL=https://sub.example.com/health/challenge
# Optional external panel probe point.
# PANEL_PROBE_URL=https://probe.example.com:9444/
# PANEL_PROBE_TOKEN=
# PANEL_PROBE_CA=/path/to/private-ca.crt
