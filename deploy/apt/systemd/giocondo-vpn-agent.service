# Node agent: holds the Sync stream with the panel, writes /etc/giocondo-vpn/sing-box/config.json,
# restarts giocondo-vpn-sing-box (hence it runs as root) and reports statistics.
# Does not start without the node certificate: install-agent.sh puts it there from the panel archive.
[Unit]
Description=giocondo-vpn node agent
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/giocondo-vpn/agent/agent.crt

[Service]
EnvironmentFile=/etc/giocondo-vpn/agent.env
ExecStart=/usr/bin/giocondo-vpn-agent
Restart=always
RestartSec=5
MemoryMax=64M
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/giocondo-vpn/sing-box
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
