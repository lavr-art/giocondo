# giocondo-vpn panel: admin UI, API and subscriptions (HTTP behind a reverse proxy with HTTPS), gRPC for agents.
# Runs as the giocondo-vpn user; data in /var/lib/giocondo-vpn/panel, settings in /etc/giocondo-vpn/panel.env.
# Does not start without the panel certificate: sudo -u giocondo-vpn giocondo-vpn-panel ca server -host <domain>,127.0.0.1
[Unit]
Description=giocondo-vpn panel
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/giocondo-vpn/panel/pki/server.crt

[Service]
User=giocondo-vpn
Group=giocondo-vpn
EnvironmentFile=/etc/giocondo-vpn/panel.env
ExecStart=/usr/bin/giocondo-vpn-panel
Restart=on-failure
RestartSec=5
StateDirectory=giocondo-vpn/panel
StateDirectoryMode=0750
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
