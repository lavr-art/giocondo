# sing-box on the node: our own build with with_v2ray_api from the vpnctl-sing-box package.
# vpnctl-agent writes the config and restarts the service.
[Unit]
Description=sing-box (managed by vpnctl-agent)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/vpnctl/sing-box/config.json

[Service]
ExecStart=/usr/lib/vpnctl/sing-box run -c /etc/vpnctl/sing-box/config.json -D /var/lib/vpnctl/sing-box
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576
# ACME certificates are kept in /var/lib/vpnctl/sing-box/acme (singbox.DefaultACMEDataDir).
StateDirectory=vpnctl/sing-box
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW

[Install]
WantedBy=multi-user.target
