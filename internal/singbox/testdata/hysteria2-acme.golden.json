{
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "local"
      }
    ]
  },
  "inbounds": [
    {
      "type": "hysteria2",
      "tag": "hy2",
      "listen": "::",
      "listen_port": 443,
      "users": [
        {
          "name": "alice",
          "password": "618ce402-4ab9-4ffc-a264-724836480a76"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "n1.example.com",
        "alpn": [
          "h3"
        ],
        "certificate_provider": {
          "type": "acme",
          "domain": [
            "n1.example.com"
          ],
          "data_directory": "/var/lib/vpnctl/sing-box/acme",
          "email": "admin@example.com"
        }
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "action": "resolve"
      },
      {
        "ip_is_private": true,
        "action": "reject"
      }
    ],
    "final": "direct",
    "default_domain_resolver": "local"
  },
  "experimental": {
    "v2ray_api": {
      "listen": "127.0.0.1:10085",
      "stats": {
        "enabled": true,
        "users": [
          "alice"
        ]
      }
    }
  }
}
